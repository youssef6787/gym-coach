NODE_ENV=development
PORT=5000

# Local MySQL
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=YOUR_LOCAL_MYSQL_PASSWORD
DB_NAME=gym_coach

# Authentication secrets
JWT_SECRET=REPLACE_WITH_A_RANDOM_64_PLUS_CHARACTER_SECRET
OTP_SECRET=REPLACE_WITH_A_DIFFERENT_RANDOM_64_PLUS_CHARACTER_SECRET

DEFAULT_PHONE_COUNTRY_CODE=20
JWT_EXPIRES_IN=7d

# Local frontend
CORS_ORIGIN=http://localhost:5173
FRONTEND_URL=http://localhost:5173

# Cloudinary - media storage only
CLOUDINARY_CLOUD_NAME=YOUR_CLOUDINARY_CLOUD_NAME
CLOUDINARY_API_KEY=YOUR_CLOUDINARY_API_KEY
CLOUDINARY_API_SECRET=YOUR_CLOUDINARY_API_SECRET

# SMTP
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=YOUR_EMAIL@example.com
SMTP_PASSWORD=YOUR_SMTP_APP_PASSWORD
SMTP_SECURE=false
SMTP_FROM=GYM COACH <YOUR_EMAIL@example.com>

BACKUP_DIR=./backups
